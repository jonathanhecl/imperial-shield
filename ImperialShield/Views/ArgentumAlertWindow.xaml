<Window x:Class="ImperialShield.Views.ArgentumAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modo Argentum Online - Alerta de Seguridad" 
        Width="650" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Storyboard x:Key="PulseIcon">
            <DoubleAnimation Storyboard.TargetName="AlertIcon" 
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                              From="1.0" To="1.1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AlertIcon" 
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                              From="1.0" To="1.1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        
        <Storyboard x:Key="BlinkAlert">
             <DoubleAnimation Storyboard.TargetName="AlertText" 
                              Storyboard.TargetProperty="Opacity"
                              From="1" To="0.4" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        
        <Storyboard x:Key="WindowEntrance">
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                              Storyboard.TargetProperty="Opacity"
                              From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                              From="0.8" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="1" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                              From="0.8" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="1" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="GlowBorder">
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                              Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                              From="0.5" To="0.95" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource BlinkAlert}"/>
            <BeginStoryboard Storyboard="{StaticResource PulseIcon}"/>
            <BeginStoryboard Storyboard="{StaticResource WindowEntrance}"/>
            <BeginStoryboard Storyboard="{StaticResource GlowBorder}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="MainBorder" CornerRadius="30" Background="#060D18" BorderBrush="#FFD700" BorderThickness="4" Opacity="0" UseLayoutRounding="True">
        <Border.RenderTransform>
            <ScaleTransform CenterX="325" CenterY="290"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="80" ShadowDepth="0" Color="#FFD700" Opacity="0.9"/>
        </Border.Effect>

        <Grid>
            <!-- Background Grid -->
            <Border Opacity="0.08" Margin="4">
                <Border.Background>
                    <VisualBrush TileMode="Tile" Viewport="0,0,60,60" ViewportUnits="Absolute">
                        <VisualBrush.Visual>
                            <Path Data="M0,0 L60,0 M0,0 L0,60" Stroke="#FFD700" StrokeThickness="0.8" StrokeDashArray="4,4"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>
            <!-- Center Glow -->
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.4" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#1C1505" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Icon (Segoe MDL2 Sword or Warning Shield) -->
                <Border x:Name="AlertIcon" Width="80" Height="80" CornerRadius="40" Background="#1D1705" BorderBrush="#FFD700" BorderThickness="2" Margin="0,0,0,10">
                    <Border.RenderTransform>
                        <ScaleTransform CenterX="40" CenterY="40"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#FFD700" Opacity="0.8"/>
                    </Border.Effect>
                    <TextBlock Text="⚔️" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Border>

                <!-- Title -->
                <TextBlock x:Name="AlertText" Grid.Row="1" Text="¡SUBPROCESO ANÓMALO BLOQUEADO!" 
                           Foreground="#FFD700" FontSize="20" FontWeight="Black" 
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#FFD700" ShadowDepth="0" Opacity="0.7"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Details Panel -->
                <Border Grid.Row="2" Background="#141107" CornerRadius="12" Padding="20,15" Margin="0,5" BorderBrush="#2E260A" BorderThickness="1,1,1,2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MODO ARGENTUM ONLINE: SE INTERCEPTÓ UNA EJECUCIÓN NO AUTORIZADA" 
                                   Foreground="#FFC83C" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LAUNCHER (PADRE):" Foreground="#B0A080" FontWeight="Bold" FontSize="11"/>
                            <TextBlock x:Name="LauncherNameText" Grid.Column="1" Text="launcher.exe" 
                                       Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RUTA LAUNCHER:" Foreground="#B0A080" FontWeight="Bold" FontSize="11"/>
                            <TextBlock x:Name="LauncherPathText" Grid.Column="1" Text="C:\Games\AO\launcher.exe" 
                                       Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SUBPROCESO (HIJO):" Foreground="#B0A080" FontWeight="Bold" FontSize="11"/>
                            <TextBlock x:Name="SubprocessNameText" Grid.Column="1" Text="unknown.exe" 
                                       Foreground="#FF6B6B" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RUTA SUBPROCESO:" Foreground="#B0A080" FontWeight="Bold" FontSize="11"/>
                            <TextBlock x:Name="SubprocessPathText" Grid.Column="1" Text="C:\Users\Temp\unknown.exe" 
                                       Foreground="#AA9A9A" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>

                        <Border Background="#211A07" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderBrush="#382C0C" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CAUSA DE RESTRICCIÓN:" Foreground="#FFD700" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock x:Name="DetailsText" Text="Intento de ejecutar un binario en una ruta temporal o comando de consola del sistema." 
                                           Foreground="#FFE090" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Button x:Name="KeepBlockedButton" Click="KeepBlocked_Click" 
                            Width="420" Height="45" Margin="0,0,0,10"
                            FontSize="14" FontWeight="Bold"
                            Background="#9A1010" Foreground="White" 
                            BorderThickness="0" Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MANTENER BLOQUEADO" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C01515"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button x:Name="WhitelistLauncherButton" Click="WhitelistLauncher_Click" 
                            Width="420" Height="45" Margin="0,0,0,10"
                            FontSize="13" FontWeight="Bold"
                            Background="#1E3A5F" Foreground="White" 
                            BorderThickness="1" BorderBrush="#4DA8DA" Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="EXCLUIR LAUNCHER (CONFIAR SIEMPRE)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A507D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="WhitelistSubprocessButton" Click="WhitelistSubprocess_Click" 
                            Width="420" Height="45" Margin="0,0,0,0"
                            FontSize="13" FontWeight="Bold"
                            Background="#1E3A5F" Foreground="White" 
                            BorderThickness="1" BorderBrush="#4DA8DA" Cursor="Hand">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="EXCLUIR SUBPROCESO DETECTADO" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A507D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
